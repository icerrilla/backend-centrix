            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "ADMIN devuelve usuario.rol sin usuario.permisos y tiene todos los permisos del catálogo. Los demás roles reciben usuario.rol y usuario.permisos agrupados por módulo con acciones true/false. GET /me refleja cambios sin volver a iniciar sesión."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.dataResponse && typeof body.dataResponse.token === 'string' && body.dataResponse.token.length > 0) {",
                  "        pm.collectionVariables.set('token', body.dataResponse.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
