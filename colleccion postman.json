          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    const usuario = body.dataResponse;",
                  "    if (body.statusCode === 201 && usuario && Number.isInteger(usuario.id) && usuario.id > 0) {",
                  "        const values = {",
                  "            usuario_id: String(usuario.id),",
                  "            usuario_nombre: usuario.nombre,",
                  "            usuario_apellido_paterno: usuario.apellido_paterno ?? '',",
                  "            usuario_apellido_materno: usuario.apellido_materno ?? '',",
                  "            usuario_login: usuario.usuario,",
                  "            usuario_email: usuario.email,",
                  "            usuario_email_nuevo: usuario.email,",
                  "            email_recuperacion: usuario.email",
                  "        };",
                  "        if (usuario.rol && usuario.rol.id != null) values.rol_id = String(usuario.rol.id);",
                  "        Object.entries(values).forEach(([key, value]) => {",
                  "            if (value != null) pm.collectionVariables.set(key, String(value));",
                  "        });",
                  "    }",
                  "}"
                ]
              }
            }
          ]
