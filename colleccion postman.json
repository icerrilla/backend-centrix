              "body": "{\r\n  \"statusCode\": 201,\r\n  \"message\": \"Usuario creado correctamente.\",\r\n  \"dataResponse\": {\r\n    \"id\": 8,\r\n    \"nombre\": \"Jared\",\r\n    \"apellido_paterno\": \"Flores\",\r\n    \"apellido_materno\": \"Guarneros\",\r\n    \"usuario\": \"jflores\",\r\n    \"email\": \"floresjared156@gmail.com\",\r\n    \"activo\": null,\r\n    \"bloqueado\": null,\r\n    \"rol\": {\r\n      \"id\": 1,\r\n      \"codigo\": \"ADMIN\",\r\n      \"nombre\": \"Administrador\"\r\n    }\r\n  },\r\n  \"errorMessageDTO\": null\r\n}"
            }
